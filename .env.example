# Secrets — ne jamais committer ce fichier
NVIDIA_API_KEY=

# Optionnel
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Vidéos stock gratuites (clés gratuites, une seule suffit)
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# Images IA gratuites (aucune clé, aucun compte). Le modèle flux/turbo est
# devenu payant côté Pollinations : sdxl reste gratuit. Le service limite le
# débit, d'où les tentatives.
# AI_IMAGE_BASE_URL=https://image.pollinations.ai
# AI_IMAGE_MODEL=sdxl
# AI_IMAGE_ATTEMPTS=6

# Habillage (barre de progression + signature). OVERLAY_FONT est optionnel.
# OVERLAY_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Exécution
# QUEUE_BACKEND=celery
# REDIS_URL=redis://localhost:6379/0
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_PUBLIC_BASE_URL=

# Génération en lot
# MAX_BATCH_SIZE=20          # nombre maximum de vidéos par lot
# MAX_CONCURRENT_JOBS=2      # rendus simultanés maximum (CPU/RAM)

# Cache local des clips stock (Pexels/Pixabay) : évite de re-télécharger les
# mêmes plans et donc de re-solliciter l'API sur des sujets répétés.
# PEXELS_CACHE_ENABLED=true
# PEXELS_CACHE_TTL_DAYS=30   # 0 = pas d'expiration
# PEXELS_CACHE_MAX_GB=5      # plafond de taille, purge LRU au démarrage
# PEXELS_CACHE_DIR=          # par défaut data/cache/pexels

# Géométrie de sortie et pression FFmpeg.
# Sur un hébergeur gratuit (Render 512 Mo), 1080x1920 tue le conteneur pendant
# le montage final : baissez la résolution et gardez un seul rendu à la fois.
# VIDEO_WIDTH=1080
# VIDEO_HEIGHT=1920
# VIDEO_FPS=30
# FFMPEG_PRESET=veryfast     # veryfast/ultrafast sur petite machine
# FFMPEG_THREADS=1           # 1 = un seul encodage en mémoire à la fois
# VIDEO_TRANSITION=0.6       # 0 = coupes franches (concat, RAM minimale)
