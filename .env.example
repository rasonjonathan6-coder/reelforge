# Secrets — ne jamais committer ce fichier
NVIDIA_API_KEY=

# Optionnel
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Vidéos stock gratuites (clés gratuites, une seule suffit)
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# Habillage (barre de progression + signature). OVERLAY_FONT est optionnel.
# OVERLAY_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Exécution
# QUEUE_BACKEND=celery
# REDIS_URL=redis://localhost:6379/0
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_PUBLIC_BASE_URL=

# Génération en lot
# MAX_BATCH_SIZE=20          # nombre maximum de vidéos par lot
# MAX_CONCURRENT_JOBS=2      # rendus simultanés maximum (CPU/RAM)
